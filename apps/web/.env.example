# StudyPilot v2 — Web UI environment template.
# Copy this file to `.env.local` and fill in values as needed.
# Vite only exposes vars prefixed with VITE_ to the client.

# Clerk publishable key.
# Set this to enable Clerk authentication in production.
# When empty, the app runs in dev-bypass / unauthenticated mode (all routes open).
VITE_CLERK_PUBLISHABLE_KEY=

# API proxy target for the Vite dev server (/api and /health are proxied here).
VITE_API_PROXY_TARGET=http://localhost:8002

# Dev server port. Defaults to 5175 to avoid colliding with the Weathero project on 5173.
VITE_DEV_PORT=5175
